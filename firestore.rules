rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Professor só consulta seu registro pelo e-mail autenticado.
    // Pode atualizar Nome/uid do próprio registro, sem alterar o e-mail autorizado.
    match /professores/{professorId} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == resource.data.Email;

      allow update: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == resource.data.Email
        && request.resource.data.Email == resource.data.Email;
      allow create, delete: if false;
    }

    // Demais dados exigem autenticação com e-mail (não usuário anônimo).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email != null;
    }
  }
}
